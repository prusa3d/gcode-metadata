; start_gcode = {\nglobal retract_toolchange = 8;\nglobal tool_init = (0,0,0,0,0,0,0,0);\nglobal used_tools = 0 ;\nglobal low_temp_types = "PLA|PVA|BVOH|FLEX|TPU|TPE|PVB";\n}\n\n; number of used tools\n{if is_extruder_used[0]}{used_tools = used_tools + 1}{endif}\n{if is_extruder_used[1]}{used_tools = used_tools + 1}{endif}\n{if is_extruder_used[2]}{used_tools = used_tools + 1}{endif}\n{if is_extruder_used[3]}{used_tools = used_tools + 1}{endif}\n{if is_extruder_used[4]}{used_tools = used_tools + 1}{endif}\n{if is_extruder_used[5]}{used_tools = used_tools + 1}{endif}\n{if is_extruder_used[6]}{used_tools = used_tools + 1}{endif}\n{if is_extruder_used[7]}{used_tools = used_tools + 1}{endif}\n\n{local probe_temp = "" + ((filament_notes[initial_tool]=~/.*MBL160.*/) ? 160 : (filament_notes[initial_tool]=~/.*HT_MBL10.*/) ? (first_layer_temperature[initial_tool] - 10) : (filament_type[initial_tool] == "PC" or filament_type[initial_tool] == "PA") ? (first_layer_temperature[initial_tool] - 45) : (filament_type[initial_tool]=~/(FLEX|TPU|TPE)/) ? 170 : (filament_type[initial_tool]=~/.*PET.*/) ? 170 : 170) + "";}\n\nM862.3 P "COREONEINDX" ; printer model check\nM862.5 P2 ; g-code level check\nM862.6 P"Input shaper" ; FW feature check\nM862.6 P"INDX lock" ; FW feature check\nM115 U6.6.1+15545\n\nM591 S0 ; disable stuck detection\n\nM555 X{(min(print_bed_max[0], first_layer_print_min[0] + 32) - 32)} Y{(max(0, first_layer_print_min[1]) - 4)} W{((min(print_bed_max[0], max(first_layer_print_min[0] + 32, first_layer_print_max[0])))) - ((min(print_bed_max[0], first_layer_print_min[0] + 32) - 32))} H{((first_layer_print_max[1])) - ((max(0, first_layer_print_min[1]) - 4))}\n\n; inform about nozzle diameter\n{if (is_extruder_used[0])}M862.1 T0 P{nozzle_diameter[0]} A{(filament_abrasive[0] ? 1 : 0)} F{(nozzle_high_flow[0] ? 1 : 0)}{endif}\n{if (is_extruder_used[1])}M862.1 T1 P{nozzle_diameter[1]} A{(filament_abrasive[1] ? 1 : 0)} F{(nozzle_high_flow[1] ? 1 : 0)}{endif}\n{if (is_extruder_used[2])}M862.1 T2 P{nozzle_diameter[2]} A{(filament_abrasive[2] ? 1 : 0)} F{(nozzle_high_flow[2] ? 1 : 0)}{endif}\n{if (is_extruder_used[3])}M862.1 T3 P{nozzle_diameter[3]} A{(filament_abrasive[3] ? 1 : 0)} F{(nozzle_high_flow[3] ? 1 : 0)}{endif}\n{if (is_extruder_used[4])}M862.1 T4 P{nozzle_diameter[4]} A{(filament_abrasive[4] ? 1 : 0)} F{(nozzle_high_flow[4] ? 1 : 0)}{endif}\n{if (is_extruder_used[5])}M862.1 T5 P{nozzle_diameter[5]} A{(filament_abrasive[5] ? 1 : 0)} F{(nozzle_high_flow[5] ? 1 : 0)}{endif}\n{if (is_extruder_used[6])}M862.1 T6 P{nozzle_diameter[6]} A{(filament_abrasive[6] ? 1 : 0)} F{(nozzle_high_flow[6] ? 1 : 0)}{endif}\n{if (is_extruder_used[7])}M862.1 T7 P{nozzle_diameter[7]} A{(filament_abrasive[7] ? 1 : 0)} F{(nozzle_high_flow[7] ? 1 : 0)}{endif}\n\nG90 ; use absolute coordinates\nM83 ; extruder relative mode\n\nM140 S{first_layer_bed_temperature[initial_tool]} ; set bed temp\n\n{if chamber_minimal_temperature[initial_tool] == 0}\n  M141 S{chamber_temperature[initial_tool]} ; set nominal chamber temp\n{endif}\n\n; Home XY\nG28 XY\n\n; Pick tool for Z homing\n{if is_extruder_used[0]}T0 S1 L2 D0\n{elsif is_extruder_used[1]}T1 S1 L2 D0\n{elsif is_extruder_used[2]}T2 S1 L2 D0\n{elsif is_extruder_used[3]}T3 S1 L2 D0\n{elsif is_extruder_used[4]}T4 S1 L2 D0\n{elsif is_extruder_used[5]}T5 S1 L2 D0\n{elsif is_extruder_used[6]}T6 S1 L2 D0\n{elsif is_extruder_used[7]}T7 S1 L2 D0\n{endif}\n\nM104 S120\n\n; Home Z\nG28 Z\n\nG0 Z40 F10000\nM190 R{first_layer_bed_temperature[initial_tool]} ; wait for bed temp\n; try picking tools used in print\nG1 F10000\n\n{local perimeter_flow_rate = (\n  1.0 * (external_perimeter_speed[0] > 0 ? external_perimeter_speed[0] : (perimeter_speed[0] > 0 ? perimeter_speed[0] : 100)) * (layer_height * (external_perimeter_extrusion_width[0] - layer_height) + 3.14159 * (layer_height/2) * (layer_height/2)),\n  1.0 * (external_perimeter_speed[1] > 0 ? external_perimeter_speed[1] : (perimeter_speed[1] > 0 ? perimeter_speed[1] : 100)) * (layer_height * (external_perimeter_extrusion_width[1] - layer_height) + 3.14159 * (layer_height/2) * (layer_height/2)),\n  1.0 * (external_perimeter_speed[2] > 0 ? external_perimeter_speed[2] : (perimeter_speed[2] > 0 ? perimeter_speed[2] : 100)) * (layer_height * (external_perimeter_extrusion_width[2] - layer_height) + 3.14159 * (layer_height/2) * (layer_height/2)),\n  1.0 * (external_perimeter_speed[3] > 0 ? external_perimeter_speed[3] : (perimeter_speed[3] > 0 ? perimeter_speed[3] : 100)) * (layer_height * (external_perimeter_extrusion_width[3] - layer_height) + 3.14159 * (layer_height/2) * (layer_height/2)),\n  1.0 * (external_perimeter_speed[4] > 0 ? external_perimeter_speed[4] : (perimeter_speed[4] > 0 ? perimeter_speed[4] : 100)) * (layer_height * (external_perimeter_extrusion_width[4] - layer_height) + 3.14159 * (layer_height/2) * (layer_height/2)),\n  1.0 * (external_perimeter_speed[5] > 0 ? external_perimeter_speed[5] : (perimeter_speed[5] > 0 ? perimeter_speed[5] : 100)) * (layer_height * (external_perimeter_extrusion_width[5] - layer_height) + 3.14159 * (layer_height/2) * (layer_height/2)),\n  1.0 * (external_perimeter_speed[6] > 0 ? external_perimeter_speed[6] : (perimeter_speed[6] > 0 ? perimeter_speed[6] : 100)) * (layer_height * (external_perimeter_extrusion_width[6] - layer_height) + 3.14159 * (layer_height/2) * (layer_height/2)),\n  1.0 * (external_perimeter_speed[7] > 0 ? external_perimeter_speed[7] : (perimeter_speed[7] > 0 ? perimeter_speed[7] : 100)) * (layer_height * (external_perimeter_extrusion_width[7] - layer_height) + 3.14159 * (layer_height/2) * (layer_height/2))\n);}\n\n{if (is_extruder_used[0] and filament_type[0] != "FLEX")}M574 S0 V90 T{temperature[0]} F{ (filament_max_volumetric_speed[0] > 0 ? min(perimeter_flow_rate[0], filament_max_volumetric_speed[0]) : perimeter_flow_rate[0] ) / (3.14159 / 4 * filament_diameter[0] * filament_diameter[0]) }{endif}\n{if (is_extruder_used[1] and filament_type[1] != "FLEX")}M574 S1 V90 T{temperature[1]} F{ (filament_max_volumetric_speed[1] > 0 ? min(perimeter_flow_rate[1], filament_max_volumetric_speed[1]) : perimeter_flow_rate[1] ) / (3.14159 / 4 * filament_diameter[1] * filament_diameter[1]) }{endif}\n{if (is_extruder_used[2] and filament_type[2] != "FLEX")}M574 S2 V90 T{temperature[2]} F{ (filament_max_volumetric_speed[2] > 0 ? min(perimeter_flow_rate[2], filament_max_volumetric_speed[2]) : perimeter_flow_rate[2] ) / (3.14159 / 4 * filament_diameter[2] * filament_diameter[2]) }{endif}\n{if (is_extruder_used[3] and filament_type[3] != "FLEX")}M574 S3 V90 T{temperature[3]} F{ (filament_max_volumetric_speed[3] > 0 ? min(perimeter_flow_rate[3], filament_max_volumetric_speed[3]) : perimeter_flow_rate[3] ) / (3.14159 / 4 * filament_diameter[3] * filament_diameter[3]) }{endif}\n{if (is_extruder_used[4] and filament_type[4] != "FLEX")}M574 S4 V90 T{temperature[4]} F{ (filament_max_volumetric_speed[4] > 0 ? min(perimeter_flow_rate[4], filament_max_volumetric_speed[4]) : perimeter_flow_rate[4] ) / (3.14159 / 4 * filament_diameter[4] * filament_diameter[4]) }{endif}\n{if (is_extruder_used[5] and filament_type[5] != "FLEX")}M574 S5 V90 T{temperature[5]} F{ (filament_max_volumetric_speed[5] > 0 ? min(perimeter_flow_rate[5], filament_max_volumetric_speed[5]) : perimeter_flow_rate[5] ) / (3.14159 / 4 * filament_diameter[5] * filament_diameter[5]) }{endif}\n{if (is_extruder_used[6] and filament_type[6] != "FLEX")}M574 S6 V90 T{temperature[6]} F{ (filament_max_volumetric_speed[6] > 0 ? min(perimeter_flow_rate[6], filament_max_volumetric_speed[6]) : perimeter_flow_rate[6] ) / (3.14159 / 4 * filament_diameter[6] * filament_diameter[6]) }{endif}\n{if (is_extruder_used[7] and filament_type[7] != "FLEX")}M574 S7 V90 T{temperature[7]} F{ (filament_max_volumetric_speed[7] > 0 ? min(perimeter_flow_rate[7], filament_max_volumetric_speed[7]) : perimeter_flow_rate[7] ) / (3.14159 / 4 * filament_diameter[7] * filament_diameter[7]) }{endif}\n\nG427 R2 P3 ; Calibrate all used and mapped tools\n\nT{initial_tool} S1 L0 D0\n\n{if chamber_minimal_temperature[initial_tool] != 0}\n  ; Min chamber temp section\n  M104 S0\n  M140 S115 ; set bed temp for chamber heating\n  G1 Z10 F720 ; set bed position\n  G1 X242 Y0 F4800 ; set print head position\n  M191 S{chamber_minimal_temperature[initial_tool]} ; wait for minimal chamber temp\n  M141 S{chamber_temperature[initial_tool]} ; set nominal chamber temp\n  M140 S{first_layer_bed_temperature[initial_tool]} ; set bed temp\n{endif}\n\n{if first_layer_bed_temperature[initial_tool] <= 60}M106 S70{endif}\nG0 Z40 F10000\nM104 S{if is_nil(idle_temperature[initial_tool])}100{else}{idle_temperature[initial_tool]}{endif}\nM190 R{first_layer_bed_temperature[initial_tool]} ; wait for bed temp\nM107\n\nG29 G ; absorb heat\n\nM109 S{probe_temp} ; wait for temp\n\n;\n; MBL\n;\nM84 E ; turn off E motor\nG29 P1 ; invalidate mbl & probe print area\n;G29 P1 X150 Y0 W100 H20 C ; probe near purge place\nG29 P3.2 ; interpolate mbl probes\nG29 P3.13 ; extrapolate mbl outside probe area\nG29 A ; activate mbl\n\nG0 Z1 ; add Z clearance\n\nM569 S0 E ; set spreadcycle mode for extruder\nG92 E0 ; reset extruder position\n\n;-------Clean and prime initial tool------\n{\nlocal speed_tc = min(travel_speed, 350.0) * 60;\nlocal deretract_length = 1.6;\nlocal target_temp = first_layer_temperature[initial_tool];\nlocal eject_temp = max(160,target_temp - 60);\nlocal filament_area = 3.14 * filament_diameter[initial_tool] * filament_diameter[initial_tool] / 4.0;\nlocal purge_mm = 12 / filament_area;\nlocal purge_speed_fast = 60.0 * min(6,max(1.5,0.6*filament_max_volumetric_speed[initial_tool]/filament_area));\nlocal purge_speed_slow = 60.0 * min(3,max(1.5,0.3*filament_max_volumetric_speed[initial_tool]/filament_area));\nlocal tc_deretract_speed = 60.0 * min(20,max(5,deretract_speed[initial_tool]));\n}\n\n{if filament_flush_speed[initial_tool] > 0}\n  {purge_speed_fast = 60.0 * min(10,max(1,filament_flush_speed[initial_tool]))}\n  {purge_speed_slow = 60.0 * min(10,max(1,filament_flush_speed[initial_tool] / 2))}\n{endif}\n\n{if filament_type[initial_tool]=="FLEX"}\n  {tc_deretract_speed = 60*10}\n{endif}\n\nM83\n\nG1 F{speed_tc}\n\nM204 S7000\n\nM104 S{eject_temp+15}\n\nG12 S90 ; enter cleaner\n\nM109 C{eject_temp} ; Skip residency\n\nM104 S{target_temp + 5}\n\nG12 S30 ; eject poop\n\nM106 S{255 / 100 * max_fan_speed[initial_tool]}\n\nM906 P1 ; Set extruder current\n\nM109 C{target_temp}\n\nM104 S{target_temp}\n\nG1 E{deretract_length} F{tc_deretract_speed}\n\nG91 ; use relative coordinates\nM83 ; extruder relative mode\nM572 S0.0 ; Disable PressureAdvance\n\n;FLUSH_START\nG1 X-0.2 E{0.15 * purge_mm} F{0.20 / (0.15 * purge_mm) * purge_speed_slow}\nG1 X0.40 E{0.30 * purge_mm} F{0.40 / (0.30 * purge_mm) * purge_speed_slow}\nG1 Y-0.5 E{0.10 * purge_mm} F{0.50 / (0.10 * purge_mm) * purge_speed_slow}\nG1 Y-0.5 E{0.10 * purge_mm} F{0.50 / (0.10 * purge_mm) * purge_speed_fast}\nG1 X-0.4 E{0.20 * purge_mm} F{0.40 / (0.20 * purge_mm) * purge_speed_fast}\nG1 Y1.00 E{0.18 * purge_mm} F{1.00 / (0.18 * purge_mm) * purge_speed_fast}\nG1 X0.20 E{0.05 * purge_mm} F{0.20 / (0.05 * purge_mm) * purge_speed_fast}\nG1 Y0.20 E{0.02 * purge_mm} F{0.20 / (0.02 * purge_mm) * purge_speed_slow}\n;FLUSH_END\n\nM400\nM906 P0 ; Revert extruder current\n\nG1 Y0 E-{retract_length[initial_tool] + 0.04} F{retract_speed[initial_tool] * 60}\n{e_retracted[initial_tool] = retract_length[initial_tool] + retract_restart_extra_toolchange[initial_tool]}\n\nG1 Y5 F{speed_tc}\n\n{tool_init[initial_tool] = 1}\nG90 ; use absolute coordinates\nM83 ; extruder relative mode\nG12 S91 ; Exit cleaning station\nG0 Z1.2 ; Lift\nG4 S0\nM221 S100 ; set flow to 100%
